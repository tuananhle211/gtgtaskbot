# MeoBot environment template.
# Copy to .env and fill in real values:  cp .env.example .env
# NEVER commit .env - it is git-ignored on purpose.

# --- Application ------------------------------------------------------------
APP_ENV=development
APP_NAME=MeoBot
APP_TIMEZONE=Asia/Ho_Chi_Minh
LOG_LEVEL=INFO
# json (production) or console (development)
LOG_FORMAT=json

# --- Database ---------------------------------------------------------------
# POSTGRES_* are consumed by the postgres container; DATABASE_URL by the app.
# Keep the password identical in both.
POSTGRES_DB=meobot
POSTGRES_USER=meobot
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+asyncpg://meobot:change_me@postgres:5432/meobot

# --- Redis / Celery ---------------------------------------------------------
# db 0 = cache, db 1 = broker, db 2 = results. Keeping them apart makes a
# FLUSHDB on one of them survivable.
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Telegram ---------------------------------------------------------------
# The bot container refuses to start without a token. api/worker/beat do not
# need it. Get your numeric id from @userinfobot.
TELEGRAM_BOT_TOKEN=
MEOBOT_OWNER_TELEGRAM_ID=

# --- LLM --------------------------------------------------------------------
# fake   = deterministic offline provider, no key needed (default).
# openai = any OpenAI-compatible /v1/chat/completions endpoint.
# No model name is hardcoded anywhere: LLM_MODEL is required for 'openai'.
LLM_PROVIDER=fake
LLM_API_KEY=
LLM_MODEL=
# Optional: point at an OpenAI-compatible gateway instead of OpenAI itself.
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=90

# --- Google (Sheets and Drive are both live) --------------------------------
# Path INSIDE the container to the service-account JSON. Put the file at
# ./secrets/google-service-account.json on the host; compose mounts it
# read-only into api, bot and worker only.
# Share every target Sheet AND every destination folder with the service
# account's client_email.
# Leave empty to run without Google: only the Google-backed features fail.
GOOGLE_SERVICE_ACCOUNT_FILE=/run/secrets/google-service-account.json

# --- Google Drive (all optional) --------------------------------------------
# Strongly recommended. A file a service account creates in *My Drive* has no
# human owner and your team cannot recover it. In a Shared Drive, the drive
# owns the file. Copy the id from the Shared Drive URL.
GOOGLE_SHARED_DRIVE_ID=
# When set, MeoBot refuses to register or use any folder outside this tree.
# Leave empty to allow any folder that has been explicitly registered.
GOOGLE_DRIVE_ROOT_FOLDER_ID=
# Human-designed Sheets that MeoBot copies with files.copy - this preserves
# formatting, formulas, dropdowns, charts, conditional formatting and protected
# ranges. Leave empty to generate a blank spreadsheet with standard headers
# instead; MeoBot always tells you which of the two it did.
GOOGLE_WORK_SHEET_TEMPLATE_ID=
GOOGLE_SCRIPT_SHEET_TEMPLATE_ID=

# --- Natural conversation ---------------------------------------------------
# Master switch for the chat branch. With CHAT_ENABLED=false MeoBot still runs
# every command and every tool; it just stops answering conversationally.
CHAT_ENABLED=true
# Recent turns replayed to the model. Older context survives as a rolling
# summary, so the prompt stays bounded however long a thread runs.
CHAT_HISTORY_MAX_MESSAGES=20
# New turns to accumulate before summarising.
CHAT_SUMMARY_TRIGGER_MESSAGES=30
CHAT_RESPONSE_MAX_TOKENS=1200
# Show "typing..." while the model is thinking.
CHAT_TYPING_INDICATOR=true
# In a group, only answer when @mentioned or replied to. Turning this off makes
# MeoBot reply to every message in the group, which is rarely what anyone wants.
# A private chat never requires a mention, whatever this is set to.
CHAT_GROUP_REQUIRES_MENTION=true

# --- Assistant identity and workspace ---------------------------------------
# Rendered into the [WORKSPACE] and [CURRENT USER] sections of the prompt, and
# shown by /assistant_profile and /whoami. Configuration rather than constants,
# so a second deployment needs no code change and no private detail is
# committed. The OWNER_* values only *seed* the owner's profile on first
# contact; /set_preferred_address and the profile row win afterwards.
MEOBOT_ORGANIZATION_NAME=Apexmed
MEOBOT_DEPARTMENT_NAME=Phòng PR Truyền thông
MEOBOT_DEPARTMENT_SIZE=Khoảng 20 nhân sự
MEOBOT_OWNER_TITLE=Trưởng phòng PR Truyền thông
# How MeoBot addresses the owner. Leave empty for the neutral default ("bạn"),
# which assumes nothing about gender.
MEOBOT_OWNER_PREFERRED_ADDRESS=bạn

# --- Integrations (interfaces only; nothing calls them yet) -----------------
META_APP_ID=
META_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- PR channel connectors: YouTube auto-sync (Step 1F.2.4b) ---------------
# All optional. Leave every one of them empty and MeoBot starts normally; only
# the YouTube connector reports "Cấu hình YouTube chưa sẵn sàng" and channel
# metrics stay manual, exactly as in Step 1F.2.4a.
#
# Key for secrets that must live in the database and be read back - today,
# exactly one thing: a channel connector's OAuth refresh token. 32 random bytes,
# base64. Generate one with:
#   uv run python -c "from meobot.core.secrets import generate_key; print(generate_key())"
# LOSING THIS KEY means every stored refresh token becomes unreadable and every
# connected channel must be reconnected by hand. Back it up where you back up
# POSTGRES_PASSWORD.
PR_SECRET_ENCRYPTION_KEY=
# Alternative delivery: a file holding the same base64 key, mounted read-only
# through the existing ./secrets volume. Use one or the other, not both.
PR_SECRET_ENCRYPTION_KEY_FILE=
# Only needed when rotating. New values are written with this key id; retired
# keys go in the list below as <key_id>:<base64 key>, comma separated, and are
# used for decryption only.
PR_SECRET_ENCRYPTION_KEY_ID=primary
PR_SECRET_ENCRYPTION_KEYS_OLD=

# Google OAuth client for the YouTube connector - a WEB APPLICATION client from
# a Google Cloud project with the YouTube Data API v3 and the YouTube Analytics
# API enabled. See docs/pr/STEP_1F24B_YOUTUBE_CHANNEL_CONNECTOR.md.
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
# Must match a redirect URI registered on that client EXACTLY. Left empty it is
# derived as {WEB_BASE_URL}/api/pr/channels/connections/youtube/callback.
YOUTUBE_OAUTH_REDIRECT_URI=

# Scheduled syncing. Off leaves connections in place and stops the beat job;
# "Đồng bộ ngay" keeps working.
PR_CHANNEL_SYNC_ENABLED=true
# How often the sweeper looks for due connections (seconds). Not the cadence.
PR_CHANNEL_SYNC_SWEEP_INTERVAL_SECONDS=3600
# The cadence: a connection is due when its last SUCCESSFUL sync is older than
# this. Daily. Channel figures do not move fast enough to justify spending
# YouTube quota hourly, and Analytics data is ~2 days behind regardless.
PR_CHANNEL_SYNC_MIN_INTERVAL_SECONDS=86400

# --- PR recurring work (M4B) ------------------------------------------------
# Whether beat generates work from active recurring templates. A kill switch
# rather than a feature flag: stopping the scheduler must not mean ending every
# template one at a time and then remembering which to restart. Templates keep
# their state and their cursors, and catch-up resumes from where it stopped -
# bounded by MAX_CATCH_UP_DAYS, so a long outage does not file months of work.
PR_RECURRING_WORK_ENABLED=true
# How often the sweeper looks for templates with firings due (seconds). Five
# minutes: the sweep is one indexed query that usually returns nothing, and this
# is how long after 09:00 a routine job appears on somebody's board.
PR_RECURRING_SWEEP_INTERVAL_SECONDS=300

# --- PR channel connectors: Meta (Step 1F.2.4c) ----------------------------
# Facebook Page and Instagram professional-account auto-sync. Optional: leave
# these empty and MeoBot starts normally; only the Meta connect controls report
# "Cấu hình Meta chưa sẵn sàng" and those channels stay manual.
#
# META_APP_ID / META_APP_SECRET already exist above and are REUSED - one Meta
# app, one pair of credentials. The connector also needs PR_SECRET_ENCRYPTION_KEY
# (see the block above), because it stores a long-lived Page access token.
#
# Must match a Valid OAuth Redirect URI on the Meta app EXACTLY. Left empty it
# is derived as {WEB_BASE_URL}/api/pr/channels/connections/meta/callback.
META_OAUTH_REDIRECT_URI=
# The ONE Graph version string in the deployment. MeoBot never calls an
# unversioned Graph endpoint. Meta retires a version roughly two years after it
# ships, so bumping this is a restart rather than a release.
META_GRAPH_API_VERSION=v23.0
# How long a Meta connection may wait for somebody to pick a Page or an
# Instagram account before the long-lived user token it is holding is dropped.
META_ACCOUNT_SELECTION_TTL_SECONDS=1800

# --- Optional Cloudflare tunnel (profile: tunnel, off by default) -----------
CLOUDFLARE_TUNNEL_TOKEN=

# --- Behaviour tuning -------------------------------------------------------
CONFIRMATION_TTL_SECONDS=300
HTTP_TIMEOUT_SECONDS=15
API_DOCS_ENABLED=true
# How long a half-finished Telegram flow (/add_sheet, revision comment) lives.
CONVERSATION_TTL_SECONDS=3600
# Celery beat interval for sheets.sync_all_active_profiles.
SHEET_SYNC_INTERVAL_SECONDS=1800
# Automatically review scripts that are waiting for one.
AUTO_REVIEW_ENABLED=true

# --- Tương tác tiếng Việt cho Member (0.6.0A) --------------------------------
# Tất cả đều có mặc định an toàn. Không bắt buộc đặt biến nào ở đây.

# Một luồng dở dang (xin nghỉ, nộp kết quả) sống được bao lâu.
MEMBER_FLOW_TTL_SECONDS=1800
# "Việc số 2" còn hiểu đúng trong bao lâu. Ngắn hơn TTL của luồng, vì một tham
# chiếu theo số bị cũ là thứ nguy hiểm.
MEMBER_LIST_CONTEXT_TTL_SECONDS=900
# Số bằng chứng tối đa cho một lần nộp.
MEMBER_MAX_PROOFS_PER_SUBMISSION=5
# Số nút tối đa trong một danh sách.
MEMBER_MAX_BUTTON_ITEMS=8
MEMBER_TYPING_INDICATOR=true
# Hiện số lượt trò chuyện AI còn lại trên màn hình chính của Member.
MEMBER_SHOW_AI_ALLOWANCE_ON_HOME=true
# Tắt nếu cách viết tắt của công ty bị hiểu sai. Dấu và hoa/thường vẫn được
# chuẩn hoá; chỉ dừng việc mở rộng viết tắt.
MEMBER_VIETNAMESE_NORMALIZATION_ENABLED=true

# --- Điều phối thông báo liên chat (0.6.0a1) ---------------------------------
# Tất cả đều có mặc định an toàn. Không bắt buộc đặt biến nào ở đây.
# KHÔNG commit chat ID thật hay Telegram ID thật vào file này — group đã đăng ký
# được lưu trong cơ sở dữ liệu, không phải trong cấu hình.

# Tắt thì thao tác nghiệp vụ vẫn lưu và tin vẫn được xếp hàng; chỉ dừng việc gửi.
NOTIFICATION_OUTBOX_ENABLED=true
NOTIFICATION_WORKER_BATCH_SIZE=20
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_RETRY_BASE_SECONDS=30
NOTIFICATION_RETRY_MAX_SECONDS=1800
# Một lượt gửi bị treo lâu hơn mức này coi như worker đã chết và được thu hồi.
NOTIFICATION_PROCESSING_TIMEOUT_SECONDS=300
NOTIFICATION_CALLBACK_TTL_SECONDS=86400
NOTIFICATION_READ_RECEIPT_ENABLED=true
# Gửi cập nhật nhân sự trung tính vào group chấm công đã đăng ký.
NOTIFICATION_ATTENDANCE_GROUP_ENABLED=true
NOTIFICATION_MAX_BROADCAST_DESTINATIONS=5

# --- Sức khoẻ nơi nhận, báo lỗi gửi và trả lời khách (0.6.0a2) --------------
# Tất cả đều có mặc định an toàn. Không bắt buộc đặt biến nào ở đây.

# Kiểm tra group đã đăng ký bằng getChat/getChatMember theo lịch, thay vì chờ
# một tin thật hỏng mới biết. KHÔNG BAO GIỜ gửi tin thử vào group.
NOTIFICATION_DESTINATION_HEALTH_ENABLED=true
NOTIFICATION_DESTINATION_HEALTH_INTERVAL_SECONDS=1800
# Giới hạn theo lô để một deployment nhiều group không bắn một loạt API call.
NOTIFICATION_DESTINATION_HEALTH_BATCH_SIZE=10
# Số lần quét xấu liên tiếp trước khi tin là nơi nhận thật sự hỏng. Một lần là
# không đủ: Telegram có những lúc trục trặc ngắn.
NOTIFICATION_HEALTH_FAILURE_THRESHOLD=2
# Tự báo cho người khởi tạo khi một tin không gửi được, thay vì chờ họ hỏi.
NOTIFICATION_FAILURE_ALERT_ENABLED=true
# Báo tiếp khi nơi nhận hoạt động trở lại.
NOTIFICATION_RECOVERY_ALERT_ENABLED=true

# Tự trả lời câu hỏi đầu tiên của khách sau khi Trưởng phòng duyệt.
NOTIFICATION_GUEST_REPLAY_ENABLED=true
# Câu hỏi chưa được duyệt sống được bao lâu. Quá hạn thì người hỏi đã đi rồi,
# và trả lời một tin nhắn của hôm qua còn tệ hơn không trả lời.
DEFERRED_GUEST_MESSAGE_TTL_SECONDS=86400
# Giữ metadata (hash, id) bao lâu sau khi nội dung đã bị xoá trắng.
DEFERRED_GUEST_MESSAGE_RETENTION_SECONDS=2592000

# --- Xác nhận đã đọc thông báo (0.6.0a2) ------------------------------------
ANNOUNCEMENT_READ_RECEIPT_ENABLED=true
ANNOUNCEMENT_READ_CALLBACK_TTL_SECONDS=604800
# Trần cho một lần "nhắc những người chưa đọc". Một lời nhắc lỡ tay gửi cho tám
# mươi người thì không thu lại được.
ANNOUNCEMENT_MAX_PRIVATE_REMINDERS=30

# --- Lịch nhắc (0.6.0a2) -----------------------------------------------------
REMINDER_ENABLED=true
# Sweep tìm lịch nhắc đến hạn. Một lịch nhắc trễ 40 giây thì không sao, trễ 15
# phút thì không còn là nhắc nữa.
REMINDER_SWEEP_INTERVAL_SECONDS=60
REMINDER_BATCH_SIZE=50
# Một lần kích hoạt lỡ được phép trễ tối đa bao lâu mà vẫn gửi. Quá mức này thì
# ghi nhận là đã bỏ qua — sau hai ngày mất điện, một lịch hằng ngày gửi một tin,
# không phải hai.
REMINDER_MISSED_GRACE_SECONDS=3600
# Để trống thì dùng APP_TIMEZONE. Tách riêng để đổi múi giờ hiển thị không âm
# thầm dời mọi lịch nhắc đang có.
REMINDER_DEFAULT_TIMEZONE=

# --- Web admin PR (Step 1E, profile: web, tắt theo mặc định) -----------------
# Địa chỉ công khai của bảng điều khiển, ví dụ https://pr.congty.com — dùng để
# dựng liên kết đăng nhập mà bot gửi, và làm origin CORS mặc định.
#
# **Để trống thì lệnh /web từ chối phát liên kết.** Đó là cố ý: một liên kết trỏ
# tới host sai là một credential gửi cho server của người khác. Không có giá trị
# mặc định nào an toàn ở đây.
WEB_BASE_URL=
# Liên kết đăng nhập sống bao lâu. Ngắn, vì nó chỉ dùng được một lần và tới ngay
# trong tin nhắn riêng — một liên kết còn dùng được ngày mai là liên kết dùng
# được cho bất kỳ ai đọc được đoạn chat đó ngày mai.
WEB_LOGIN_TOKEN_TTL_SECONDS=600
# Phiên trên browser sống bao lâu trước khi phải xin liên kết mới. Một ngày làm
# việc, để không ai còn đang đăng nhập qua đêm trên máy dùng chung.
WEB_SESSION_TTL_SECONDS=43200
# Cờ Secure trên cookie phiên. **Giữ true ở mọi nơi truy cập được qua mạng.**
# Chỉ tắt khi chạy http://localhost, nơi browser từ chối cookie Secure.
WEB_COOKIE_SECURE=true
# Origin browser khác được phép gọi API kèm cookie, phân tách bằng dấu phẩy.
# WEB_BASE_URL luôn được phép. Không dùng "*": phiên là cookie, nên origin
# wildcard là món quà cho CSRF. Triển khai chuẩn (Next proxy /api) không cần
# biến này — khi đó browser chỉ thấy một origin duy nhất.
# WEB_BASE_URL luôn được phép ở Step 1E; **Step 1E.1 đã bỏ điều đó**: CORS chỉ
# được bật khi biến này có giá trị. Triển khai chuẩn (Next proxy /api) không cần
# nó — browser chỉ thấy một origin duy nhất, nên CORS không tham gia.
WEB_EXTRA_ALLOWED_ORIGINS=

# --- Bề mặt HTTP nội bộ (Step 1E.1) ------------------------------------------
# Có mount nhóm router `/api/v1/*` của milestone 1 hay không.
#
# **Mặc định tắt, và đây chính là bản sửa bảo mật của Step 1E.1.** 51 route đó
# được viết trước khi có xác thực: **24 route ghi** được gán cho một OWNER giả và
# 26 route đọc không có actor nào cả. Tệ nhất là `PATCH /api/v1/users/{id}/role` —
# một request không cần đăng nhập là tự thăng mình lên OWNER, và vì quyền cấp
# capability PR dựa trên `user.role.manage`, toàn bộ module PR đổ theo.
#
# Chỉ bật khi bạn chắc chắn không ai ngoài máy này chạm được vào cổng 8810.
# Bật lên sẽ ghi một dòng WARNING lúc khởi động.
API_INTERNAL_ROUTERS_ENABLED=false

# --- PR AI review execution (Step 1F) ----------------------------------------
# The automated quality gate that runs when PR content enters AI_REVIEW. It uses
# the LLM_* provider configured above - there is no separate key, no second
# client and no PR-specific model setting.
#
# Off means content still enters AI_REVIEW and simply waits there for a person
# to move it, which is the pre-Step-1F behaviour. Nothing is skipped and no
# human approval gate is bypassed either way: AI review is advisory, and both
# the Team Lead and the Head still have to approve.
PR_AI_REVIEW_ENABLED=true
# How many times one review may be attempted before it is failed for good.
# Bounds the spend when a provider is misbehaving.
PR_AI_REVIEW_MAX_ATTEMPTS=3
# How often the worker looks for queued reviews. This is the delay between
# content entering AI_REVIEW and the review starting, which the panel shows as
# "Đang chờ xử lý…".
PR_AI_REVIEW_SWEEP_INTERVAL_SECONDS=20
# A review claimed longer ago than this is assumed lost to a dead worker and is
# re-queued. Comfortably longer than the Celery task time limit.
PR_AI_REVIEW_STALE_AFTER_SECONDS=900

# --- PR channel connectors: TikTok (Step 1F.2.6) -----------------------------
# Login Kit for consent, the Display API for reading. Reuses TIKTOK_CLIENT_KEY
# and TIKTOK_CLIENT_SECRET above - one TikTok app, one pair of credentials.
#
# Optional like the others: leave the pair empty and MeoBot starts normally,
# and a TikTok channel simply reports "Cấu hình TikTok chưa sẵn sàng".
#
# NOTE the name. TikTok calls the public half a *client key*, not a client id.
#
# Defaults to {WEB_BASE_URL}/api/pr/channels/connections/tiktok/callback. It
# must be registered on the TikTok app as a Redirect URI **exactly**, and TikTok
# requires https - it rejects a plain-HTTP redirect that the Google and Meta
# consoles would accept.
TIKTOK_OAUTH_REDIRECT_URI=

# --- Running the TikTok App Review demo (Step 1F.2.9) ------------------------
# What a reviewer sees at /pr/channels -> a TikTok channel -> "Kết nối TikTok"
# -> consent -> back to the same channel, now showing the account, its stats and
# its recent videos. No CLI, no database access, no developer tooling.
#
# There is ONE code path for sandbox and production. TikTok's Developer Sandbox
# is not a different host, a different API version or a different flow - it is
# an app in a different state, with its own client key and secret and its own
# registered redirect URI. So the demo is configured by pointing the three
# variables below at the sandbox app; nothing in MeoBot branches on it, and
# there is deliberately no TIKTOK_ENVIRONMENT setting to get wrong in
# production.
#
#   1. TikTok for Developers -> your app -> Sandbox. Add the TikTok account that
#      will be recorded in the demo as a *target user* of the sandbox: an
#      account outside the sandbox gets a consent screen and then an empty
#      account, which is the confusing failure this step is designed to explain
#      rather than produce.
#   2. Add Login Kit for Web and the Display API to the app, and request the
#      four scopes MeoBot asks for - and only those four:
#         user.info.basic  user.info.profile  user.info.stats  video.list
#      Sandbox grants them without waiting for review; production does not, and
#      the "Quyền truy cập" block on the panel shows exactly which ones the
#      token actually carries.
#   3. Register the redirect URI on the app, character for character:
#         {WEB_BASE_URL}/api/pr/channels/connections/tiktok/callback
#      TikTok requires https and rejects a plain-HTTP redirect, so a local demo
#      needs a tunnel (ngrok, Cloudflare Tunnel) and WEB_BASE_URL set to the
#      tunnel's https address. Set TIKTOK_OAUTH_REDIRECT_URI only when the
#      callback lives somewhere other than WEB_BASE_URL.
#   4. Fill in TIKTOK_CLIENT_KEY / TIKTOK_CLIENT_SECRET above with the sandbox
#      app's credentials, and set PR_SECRET_ENCRYPTION_KEY - without it the
#      connector reports "Cấu hình TikTok chưa sẵn sàng", because there would be
#      nowhere safe to keep the refresh token.
#   5. Register a channel on the TIKTOK platform in /pr/channels. Its platform
#      code must be exactly TIKTOK; the connect control follows the channel's
#      own platform and a channel registered as "Tiktok VN" has no connector.
#
# Switching to the production app is steps 3 and 4 again with the production
# credentials. No code, no migration and no redeploy of anything but the
# environment.
#
# The secrets never reach a browser and never reach a log: the token exchange
# happens server-side, the refresh token is stored encrypted under
# PR_SECRET_ENCRYPTION_KEY, and the panel's own API response is asserted by test
# to contain no token of any kind.

# --- PR platform policy ingestion (Step 1F.1) --------------------------------
# The daily re-read of official Meta/TikTok policy pages. Uses the existing
# outbound network capability - no API key, no credential, no new port.
#
# Refresh NEVER changes the policy production reviews use: it appends a snapshot
# when a page's text changed, and turning that into rules takes an explicit
# `meobot-policy packs build` + `packs activate`. An official page changing is
# not a decision.
PR_POLICY_REFRESH_ENABLED=true
# Daily. Policy pages change rarely, and a snapshot is only useful when
# something actually moved.
PR_POLICY_REFRESH_INTERVAL_SECONDS=86400
